    <!-- ═══════════════════════════════════════════════════════════
         ICON BUTTON STYLES — REWORK
         Problem fixed: M3Expressive IconButton uses a rounded-rectangle
         shapeAppearance by default. The ripple is clipped to that shape,
         producing a visible rectangular "ghost" on press.
         Fix: force ShapeAppearance.Material3.Corner.Full (perfect circle)
         on every icon button so the press ripple is always circular.
         All buttons are icon-only (transparent background at rest).
    ═══════════════════════════════════════════════════════════ -->

    <!--
        Base icon button: transparent background, circular ripple, text2 tint.
        All icon buttons in the app inherit from this directly or indirectly.
        - backgroundTint transparent  → no visible container at rest
        - shapeAppearance Corner.Full → ripple clipped to circle, not rectangle
        - insets zeroed               → no extra invisible padding creating a larger press area
    -->
    <style name="Widget.Fluxio.Button.Icon.Base" parent="Widget.Material3Expressive.Button.IconButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="iconTint">?attr/colorControlNormal</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- 24dp icon, 48dp touch target -->
    <style name="Widget.Fluxio.Button.Icon.Small" parent="Widget.Fluxio.Button.Icon.Base">
        <item name="iconSize">@dimen/size_icon_small</item>
        <item name="android:minWidth">@dimen/size_touchable_small</item>
        <item name="android:minHeight">@dimen/size_touchable_small</item>
    </style>

    <!--
        32dp icon, 48dp touch target.
        Previously extended Button.IconButton.Outlined — that added a visible
        stroke/border. Now correctly inherits from Icon.Base (transparent + circle).
    -->
    <style name="Widget.Fluxio.Button.Icon.Medium" parent="Widget.Fluxio.Button.Icon.Base">
        <item name="iconSize">@dimen/size_icon_medium</item>
        <item name="android:minWidth">@dimen/size_touchable_small</item>
        <item name="android:minHeight">@dimen/size_touchable_small</item>
    </style>

    <!--
        Filled primary icon button — used for album detail Play CTA and similar.
        Keeps a visible filled background (this is intentional for CTAs).
        Circle shape keeps the ripple consistent.
    -->
    <style name="Widget.Fluxio.Button.Icon.Small.Primary" parent="Widget.Material3Expressive.Button.IconButton.Filled">
        <item name="iconSize">@dimen/size_icon_small</item>
        <item name="android:minWidth">@dimen/size_touchable_small</item>
        <item name="android:minHeight">@dimen/size_touchable_small</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- Tonal secondary icon button — circular -->
    <style name="Widget.Fluxio.Button.Icon.Small.Secondary" parent="Widget.Material3Expressive.Button.IconButton.Tonal">
        <item name="iconSize">@dimen/size_icon_small</item>
        <item name="android:minWidth">@dimen/size_touchable_small</item>
        <item name="android:minHeight">@dimen/size_touchable_small</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!--
        Legacy ThemeOverlay kept for compile compatibility.
        Not used by the new Icon.Base (backgroundTint is set directly).
    -->
    <style name="ThemeOverlay.Auxio.UncheckableIconButton" parent="">
        <item name="colorContainer">@android:color/transparent</item>
        <item name="colorOnContainer">?attr/colorOnSurfaceVariant</item>
    </style>

