    <!-- ═══════════════════════════════════════════════════════════
         PLAYBACK BUTTON STYLES
         All inherit from Icon.Base → transparent + circular by default.
    ═══════════════════════════════════════════════════════════ -->

    <!--
        Overflow (⋮): flat icon, no background, text2, circular ripple.
    -->
    <style name="Widget.Fluxio.Button.Playback.More" parent="Widget.Fluxio.Button.Icon.Base" />

    <!--
        Toggle (shuffle / repeat / favourite):
        - checkable, toggleCheckedStateOnClick=false (VM drives state)
        - outline icon when unchecked, solid icon when checked (handled by drawable selectors)
        - tint from sel_checkable_icon: colorPrimary when checked, colorControlNormal when not
        - no background at any state
    -->
    <style name="Widget.Fluxio.Button.Playback.Toggle" parent="Widget.Fluxio.Button.Icon.Base">
        <item name="android:checkable">true</item>
        <item name="toggleCheckedStateOnClick">false</item>
        <item name="iconTint">@color/sel_checkable_icon</item>
    </style>

    <!--
        Skip prev/next in compact layouts (h360dp, default):
        24dp icon, 48dp touch target, text1 tint (player context).
    -->
    <style name="Widget.Fluxio.Button.Playback.Skip" parent="Widget.Fluxio.Button.Icon.Base">
        <item name="iconSize">@dimen/size_icon_small</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!--
        Skip prev/next in full player (h520dp):
        32dp icon per spec, text1 tint, circular ripple.
    -->
    <style name="Widget.Fluxio.Button.Playback.Skip.Primary" parent="Widget.Fluxio.Button.Icon.Base">
        <item name="iconSize">@dimen/size_icon_medium</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!--
        Play/pause in compact layouts (h360dp, default):
        Checkable, 24dp icon, no background, circular ripple.
    -->
    <style name="Widget.Fluxio.Button.Playback.PlayPause" parent="Widget.Fluxio.Button.Icon.Base">
        <item name="android:checkable">true</item>
        <item name="iconSize">@dimen/size_icon_small</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!--
        Play/pause in full player (h520dp):
        Spec: "play btn — icon-only, no background". 40dp icon, text1 tint, circular ripple.
    -->
    <style name="Widget.Fluxio.Button.Playback.PlayPause.Primary" parent="Widget.Fluxio.Button.Icon.Base">
        <item name="android:checkable">true</item>
        <item name="iconSize">@dimen/size_icon_large</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         FLUXIO — Artwork ShapeAppearances
         Exact radii per spec: 6 / 10 / 14 dp
    ═══════════════════════════════════════════════════════════ -->

    <!-- List items, queue rows: 6dp -->
    <style name="ShapeAppearance.Fluxio.Artwork.List" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_artwork_list</item>
    </style>

    <!-- Grid cells, collage, add-to-playlist rows: 10dp -->
    <style name="ShapeAppearance.Fluxio.Artwork.Grid" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_artwork_grid</item>
    </style>

    <!-- Large artwork in player: exactly 14dp -->
    <style name="ShapeAppearance.Fluxio.Artwork.Player" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_artwork_player</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         FLUXIO CHIP STYLES
         Widget.Fluxio.Chip.Filter: extends Material3 Filter chip.
         - unchecked: bg = colorSurfaceVariant (fluxio_element), text = colorOnSurface
         - checked:   bg = colorPrimary (album color at step 31), text = colorOnPrimary
    ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.Fluxio.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <!-- Background: transparent outline border removed -->
        <item name="chipStrokeWidth">0dp</item>
        <!-- Checked state uses colorPrimary via the M3 tonal surface mechanism -->
        <item name="chipBackgroundColor">@color/sel_chip_bg_fluxio</item>
        <item name="android:textColor">@color/sel_chip_text_fluxio</item>
    </style>

</resources>
