<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        =====================================================================
        FLUXIO THEME VARIANTS
        =====================================================================

        Theme.Fluxio (base) is defined in styles_core.xml as part of the
        versioned hierarchy: Theme.Fluxio → V23 → V27 → V29 → V31 → Base.
        Color roles are set in Theme.Fluxio.Base.

        Theme.Fluxio.Dark / Light are named aliases only — they exist so that
        UISettings can store and restore the user's preferred mode. The actual
        mode switch happens in MainActivity via AppCompatDelegate.

        Theme.Fluxio.PureBlack extends Theme.Fluxio.Base and overrides
        background/surface containers to #000000 for OLED screens. It is
        only meaningful when AppCompatDelegate is in MODE_NIGHT_YES.
        =====================================================================
    -->

    <!--
        Dark / Light are named aliases only.
        AppCompatDelegate.setDefaultNightMode(MODE_NIGHT_YES / MODE_NIGHT_NO)
        is what actually forces the mode. Keeping distinct style names lets
        UISettings persist the user's preference without extra enum machinery.
    -->
    <style name="Theme.Fluxio.Dark" parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Light" parent="Theme.Fluxio.Base" />

    <!--
        PureBlack: True-black backgrounds for OLED screens.
        Only applied when AppCompatDelegate is in MODE_NIGHT_YES.
        Extends Theme.Fluxio.Base so all Fluxio color roles are inherited;
        only the nine surface-related roles are overridden to #000000.
    -->
    <style name="Theme.Fluxio.PureBlack" parent="Theme.Fluxio.Base">
        <item name="android:colorBackground">@color/fluxio_black_bg</item>
        <item name="colorSurface">@color/fluxio_black_surface</item>
        <item name="colorSurfaceDim">@color/fluxio_black_bg</item>
        <item name="colorSurfaceBright">@color/fluxio_black_element</item>
        <item name="colorSurfaceContainerLowest">@color/fluxio_black_bg</item>
        <item name="colorSurfaceContainerLow">@color/fluxio_black_bg</item>
        <item name="colorSurfaceContainer">@color/fluxio_black_surface</item>
        <item name="colorSurfaceContainerHigh">@color/fluxio_black_surface</item>
        <item name="colorSurfaceContainerHighest">@color/fluxio_black_element</item>
    </style>

    <!--
        =====================================================================
        LEGACY ACCENT ALIASES  (kept so Accent.kt / R.style.* compile)
        All 13 accent themes and the dynamic alias now resolve to Theme.Fluxio.Base.
        The accent chooser still functions but has no visible effect.
        These will be removed when the accent system is fully stripped.
        =====================================================================
    -->
    <style name="Theme.Fluxio.Red"       parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Pink"      parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Purple"    parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.DeepPurple" parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Indigo"    parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Blue"      parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.DeepBlue"  parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Cyan"      parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Teal"      parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Green"     parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.DeepGreen" parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Lime"      parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Yellow"    parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Orange"    parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Brown"     parent="Theme.Fluxio.Base" />
    <style name="Theme.Fluxio.Grey"      parent="Theme.Fluxio.Base" />

</resources>
