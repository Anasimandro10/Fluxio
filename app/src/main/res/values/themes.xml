<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        =====================================================================
        FLUXIO THEMES
        =====================================================================

        Theme.Fluxio is the single source of truth for all color roles.
        It uses @color/fluxio_* tokens defined in:
          - values/colors.xml        (light, default)
          - values-night/colors.xml  (dark)

        AppCompatDelegate.setDefaultNightMode() controls which qualifier set
        is active at runtime. The theme itself is mode-agnostic.

        Theme.Fluxio.Dark / Light are named aliases only — they exist so that
        UISettings can store and restore the user's preferred mode. The actual
        mode switch happens in MainActivity via AppCompatDelegate.

        Theme.Fluxio.PureBlack extends Theme.Fluxio and overrides
        background/surface containers to #000000 for OLED screens. It is
        only meaningful when AppCompatDelegate is in MODE_NIGHT_YES.
        =====================================================================
    -->

    <!--
        Base / System theme.
        All Material3 color roles are mapped to @color/fluxio_* tokens.
        No fixed accent — colorPrimary uses text1 so M3 components stay
        neutral. The runtime album-art accent is applied in code only on
        the play button, progress bar and active nav icon.
    -->
    <style name="Theme.Fluxio" parent="Theme.Fluxio.Base">

        <!-- ── Backgrounds ── -->
        <item name="android:colorBackground">@color/fluxio_bg</item>
        <item name="colorOnBackground">@color/fluxio_text1</item>

        <!-- ── Surfaces ── -->
        <item name="colorSurface">@color/fluxio_surface</item>
        <item name="colorOnSurface">@color/fluxio_text1</item>
        <item name="colorSurfaceVariant">@color/fluxio_element</item>
        <item name="colorOnSurfaceVariant">@color/fluxio_text2</item>
        <item name="colorSurfaceInverse">@color/fluxio_text1</item>
        <item name="colorOnSurfaceInverse">@color/fluxio_bg</item>

        <!-- ── Surface containers (M3 elevation system) ── -->
        <item name="colorSurfaceDim">@color/fluxio_bg</item>
        <item name="colorSurfaceBright">@color/fluxio_element</item>
        <item name="colorSurfaceContainerLowest">@color/fluxio_bg</item>
        <item name="colorSurfaceContainerLow">@color/fluxio_bg</item>
        <item name="colorSurfaceContainer">@color/fluxio_surface</item>
        <item name="colorSurfaceContainerHigh">@color/fluxio_surface</item>
        <item name="colorSurfaceContainerHighest">@color/fluxio_element</item>

        <!-- ── Outlines ── -->
        <item name="colorOutline">@color/fluxio_separator</item>
        <item name="colorOutlineVariant">@color/fluxio_separator</item>

        <!--
            Primary: no fixed accent.
            text1 is used so that default M3 widgets (FABs, checkboxes, etc.)
            fall back to a neutral on-brand color.
            The actual album-art color is applied in code at runtime.
        -->
        <item name="colorPrimary">@color/fluxio_text1</item>
        <item name="colorOnPrimary">@color/fluxio_bg</item>
        <item name="colorPrimaryContainer">@color/fluxio_element</item>
        <item name="colorOnPrimaryContainer">@color/fluxio_text1</item>
        <item name="colorPrimaryInverse">@color/fluxio_bg</item>

        <!-- Secondary: subdued text2 -->
        <item name="colorSecondary">@color/fluxio_text2</item>
        <item name="colorOnSecondary">@color/fluxio_bg</item>
        <item name="colorSecondaryContainer">@color/fluxio_element</item>
        <item name="colorOnSecondaryContainer">@color/fluxio_text1</item>

        <!-- Tertiary: faint text3 -->
        <item name="colorTertiary">@color/fluxio_text3</item>
        <item name="colorOnTertiary">@color/fluxio_bg</item>
        <item name="colorTertiaryContainer">@color/fluxio_element</item>
        <item name="colorOnTertiaryContainer">@color/fluxio_text1</item>

        <!-- Error / destructive -->
        <item name="colorError">@color/fluxio_destructive</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">@color/fluxio_element</item>
        <item name="colorOnErrorContainer">@color/fluxio_destructive</item>

        <!-- Fixed / dim variants required by M3 Expressive -->
        <item name="colorPrimaryFixed">@color/fluxio_text1</item>
        <item name="colorOnPrimaryFixed">@color/fluxio_bg</item>
        <item name="colorPrimaryFixedDim">@color/fluxio_text2</item>
        <item name="colorOnPrimaryFixedVariant">@color/fluxio_bg</item>
        <item name="colorSecondaryFixed">@color/fluxio_text2</item>
        <item name="colorOnSecondaryFixed">@color/fluxio_bg</item>
        <item name="colorSecondaryFixedDim">@color/fluxio_text3</item>
        <item name="colorOnSecondaryFixedVariant">@color/fluxio_bg</item>
        <item name="colorTertiaryFixed">@color/fluxio_text3</item>
        <item name="colorOnTertiaryFixed">@color/fluxio_bg</item>
        <item name="colorTertiaryFixedDim">@color/fluxio_text3</item>
        <item name="colorOnTertiaryFixedVariant">@color/fluxio_bg</item>

    </style>

    <!--
        Dark / Light are named aliases only.
        AppCompatDelegate.setDefaultNightMode(MODE_NIGHT_YES / MODE_NIGHT_NO)
        is what actually forces the mode. Keeping distinct style names lets
        UISettings persist the user's preference without extra enum machinery.
    -->
    <style name="Theme.Fluxio.Dark" parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Light" parent="Theme.Fluxio" />

    <!--
        PureBlack: True-black backgrounds for OLED screens.
        Only applied when AppCompatDelegate is in MODE_NIGHT_YES.
        Overrides the nine surface-related color roles to #000000 / near-black.
    -->
    <style name="Theme.Fluxio.PureBlack" parent="Theme.Fluxio">
        <item name="android:colorBackground">@color/fluxio_black_bg</item>
        <item name="colorSurface">@color/fluxio_black_surface</item>
        <item name="colorSurfaceDim">@color/fluxio_black_bg</item>
        <item name="colorSurfaceBright">@color/fluxio_black_element</item>
        <item name="colorSurfaceContainerLowest">@color/fluxio_black_bg</item>
        <item name="colorSurfaceContainerLow">@color/fluxio_black_bg</item>
        <item name="colorSurfaceContainer">@color/fluxio_black_surface</item>
        <item name="colorSurfaceContainerHigh">@color/fluxio_black_surface</item>
        <item name="colorSurfaceContainerHighest">@color/fluxio_black_element</item>
    </style>

    <!--
        =====================================================================
        LEGACY ACCENT ALIASES  (kept so Accent.kt / R.style.* compile)
        All 13 accent themes and the dynamic alias now resolve to Theme.Fluxio.
        The accent chooser still functions but has no visible effect.
        These will be removed when the accent system is fully stripped.
        =====================================================================
    -->
    <style name="Theme.Fluxio.Red"       parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Pink"      parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Purple"    parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.DeepPurple" parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Indigo"    parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Blue"      parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.DeepBlue"  parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Cyan"      parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Teal"      parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Green"     parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.DeepGreen" parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Lime"      parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Yellow"    parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Orange"    parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Brown"     parent="Theme.Fluxio" />
    <style name="Theme.Fluxio.Grey"      parent="Theme.Fluxio" />

</resources>
