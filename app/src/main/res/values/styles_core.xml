<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Master parent theme -->
    <style name="Theme.Fluxio" parent="Theme.Material3Expressive.DynamicColors.DayNight" />
    <!-- Adds nicer selector attributes not supported on lollipop -->
    <style name="Theme.Fluxio.V23" parent="Theme.Fluxio" />
    <!-- Handles edge-to-edge on other styles variants -->
    <style name="Theme.Fluxio.V27" parent="Theme.Fluxio.V23">
        <item name="android:statusBarColor">@color/chrome_translucent</item>
        <item name="android:navigationBarColor">@color/chrome_translucent</item>
    </style>
    <!-- Adds fully transparent system bars -->
    <style name="Theme.Fluxio.V29" parent="Theme.Fluxio.V27" />
    <!-- Adds an animated splash screen. -->
    <style name="Theme.Fluxio.V31" parent="Theme.Fluxio.V29" />

    <!-- Base theme: widget overrides + color roles + typography -->
    <style name="Theme.Fluxio.Base" parent="Theme.Fluxio.V31">

        <!-- ── Backgrounds ── -->
        <item name="android:colorBackground">@color/fluxio_bg</item>
        <item name="colorOnBackground">@color/fluxio_text1</item>

        <!-- ── Surfaces ── -->
        <item name="colorSurface">@color/fluxio_surface</item>
        <item name="colorOnSurface">@color/fluxio_text1</item>
        <item name="colorSurfaceVariant">@color/fluxio_element</item>
        <item name="colorOnSurfaceVariant">@color/fluxio_text2</item>
        <item name="colorSurfaceInverse">@color/fluxio_text1</item>
        <item name="colorOnSurfaceInverse">@color/fluxio_bg</item>

        <!-- ── Surface containers (M3 elevation system) ── -->
        <item name="colorSurfaceDim">@color/fluxio_bg</item>
        <item name="colorSurfaceBright">@color/fluxio_element</item>
        <item name="colorSurfaceContainerLowest">@color/fluxio_bg</item>
        <item name="colorSurfaceContainerLow">@color/fluxio_bg</item>
        <item name="colorSurfaceContainer">@color/fluxio_surface</item>
        <item name="colorSurfaceContainerHigh">@color/fluxio_surface</item>
        <item name="colorSurfaceContainerHighest">@color/fluxio_element</item>

        <!-- ── Outlines ── -->
        <item name="colorOutline">@color/fluxio_separator</item>
        <item name="colorOutlineVariant">@color/fluxio_separator</item>

        <!--
            Primary: no fixed accent.
            text1 is used so that default M3 widgets (FABs, checkboxes, etc.)
            fall back to a neutral on-brand color.
            The actual album-art color is applied in code at runtime.
        -->
        <item name="colorPrimary">@color/fluxio_text1</item>
        <item name="colorOnPrimary">@color/fluxio_bg</item>
        <item name="colorPrimaryContainer">@color/fluxio_element</item>
        <item name="colorOnPrimaryContainer">@color/fluxio_text1</item>
        <item name="colorPrimaryInverse">@color/fluxio_bg</item>

        <!-- Secondary: subdued text2 -->
        <item name="colorSecondary">@color/fluxio_text2</item>
        <item name="colorOnSecondary">@color/fluxio_bg</item>
        <item name="colorSecondaryContainer">@color/fluxio_element</item>
        <item name="colorOnSecondaryContainer">@color/fluxio_text1</item>

        <!-- Tertiary: faint text3 -->
        <item name="colorTertiary">@color/fluxio_text3</item>
        <item name="colorOnTertiary">@color/fluxio_bg</item>
        <item name="colorTertiaryContainer">@color/fluxio_element</item>
        <item name="colorOnTertiaryContainer">@color/fluxio_text1</item>

        <!-- Error / destructive -->
        <item name="colorError">@color/fluxio_destructive</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">@color/fluxio_element</item>
        <item name="colorOnErrorContainer">@color/fluxio_destructive</item>

        <!-- Fixed / dim variants required by M3 Expressive -->
        <item name="colorPrimaryFixed">@color/fluxio_text1</item>
        <item name="colorOnPrimaryFixed">@color/fluxio_bg</item>
        <item name="colorPrimaryFixedDim">@color/fluxio_text2</item>
        <item name="colorOnPrimaryFixedVariant">@color/fluxio_bg</item>
        <item name="colorSecondaryFixed">@color/fluxio_text2</item>
        <item name="colorOnSecondaryFixed">@color/fluxio_bg</item>
        <item name="colorSecondaryFixedDim">@color/fluxio_text3</item>
        <item name="colorOnSecondaryFixedVariant">@color/fluxio_bg</item>
        <item name="colorTertiaryFixed">@color/fluxio_text3</item>
        <item name="colorOnTertiaryFixed">@color/fluxio_bg</item>
        <item name="colorTertiaryFixedDim">@color/fluxio_text3</item>
        <item name="colorOnTertiaryFixedVariant">@color/fluxio_bg</item>

        <!-- Material configuration -->
        <item name="appBarLayoutStyle">@style/Widget.Fluxio.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.Fluxio.Toolbar</item>
        <item name="tabStyle">@style/Widget.Fluxio.TabLayout</item>
        <item name="tabSecondaryStyle">@style/Widget.Fluxio.TabLayout.Secondary</item>
        <item name="materialButtonStyle">@style/Widget.Fluxio.Button</item>
        <item name="materialButtonTonalStyle">@style/Widget.Fluxio.Button.TonalButton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Fluxio.Button.OutlinedButton</item>
        <item name="materialButtonElevatedStyle">@style/Widget.Fluxio.Button.ElevatedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.Fluxio.Button.TextButton</item>
        <item name="snackbarButtonStyle">@style/Widget.Fluxio.Button.TextButton.Snackbar</item>
        <item name="materialIconButtonStyle">@style/Widget.Fluxio.Button.Icon.Base</item>
        <item name="materialIconButtonOutlinedStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Outlined
        </item>
        <item name="materialIconButtonFilledStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Filled
        </item>
        <item name="materialIconButtonFilledTonalStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Tonal
        </item>
        <item name="materialSplitButtonStyle">@style/Widget.Fluxio.SplitButton</item>
        <item name="materialSplitButtonLeadingFilledStyle">
            @style/Widget.Fluxio.SplitButton.LeadingButton.Filled
        </item>
        <item name="materialSplitButtonLeadingFilledTonalStyle">
            @style/Widget.Fluxio.SplitButton.LeadingButton.Filled.Tonal
        </item>
        <item name="materialSplitButtonIconFilledStyle">
            @style/Widget.Fluxio.SplitButton.IconButton.Filled
        </item>
        <item name="materialSplitButtonIconFilledTonalStyle">
            @style/Widget.Fluxio.SplitButton.IconButton.Filled.Tonal
        </item>
        <item name="materialAlertDialogTheme">@style/Theme.Fluxio.Dialog</item>
        <item name="sliderStyle">@style/Widget.Fluxio.Slider</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.Fluxio.LinearProgressIndicator</item>
        <item name="bottomSheetStyle">@style/Widget.Fluxio.BottomSheet</item>
        <item name="bottomSheetDialogTheme">@style/Widget.Fluxio.BottomSheet.Dialog</item>
        <item name="bottomSheetDragHandleStyle">@style/Widget.Fluxio.BottomSheet.Handle</item>

        <!-- typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Auxio.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Auxio.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Auxio.DisplaySmall</item>
        <item name="textAppearanceDisplayLargeEmphasized">@style/TextAppearance.Auxio.DisplayLarge.Emphasized</item>
        <item name="textAppearanceDisplayMediumEmphasized">@style/TextAppearance.Auxio.DisplayMedium.Emphasized</item>
        <item name="textAppearanceDisplaySmallEmphasized">@style/TextAppearance.Auxio.DisplaySmall.Emphasized</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Auxio.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Auxio.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Auxio.HeadlineSmall</item>
        <item name="textAppearanceHeadlineLargeEmphasized">@style/TextAppearance.Auxio.HeadlineLarge.Emphasized</item>
        <item name="textAppearanceHeadlineMediumEmphasized">@style/TextAppearance.Auxio.HeadlineMedium.Emphasized</item>
        <item name="textAppearanceHeadlineSmallEmphasized">@style/TextAppearance.Auxio.HeadlineSmall.Emphasized</item>

        <item name="textAppearanceTitleLarge">@style/TextAppearance.Auxio.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Auxio.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Auxio.TitleSmall</item>
        <item name="textAppearanceTitleLargeEmphasized">@style/TextAppearance.Auxio.TitleLarge.Emphasized</item>
        <item name="textAppearanceTitleMediumEmphasized">@style/TextAppearance.Auxio.TitleMedium.Emphasized</item>
        <item name="textAppearanceTitleSmallEmphasized">@style/TextAppearance.Auxio.TitleSmall.Emphasized</item>

        <item name="textAppearanceLabelLarge">@style/TextAppearance.Auxio.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Auxio.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Auxio.LabelSmall</item>
        <item name="textAppearanceLabelLargeEmphasized">@style/TextAppearance.Auxio.LabelLarge.Emphasized</item>
        <item name="textAppearanceLabelMediumEmphasized">@style/TextAppearance.Auxio.LabelMedium.Emphasized</item>
        <item name="textAppearanceLabelSmallEmphasized">@style/TextAppearance.Auxio.LabelSmall.Emphasized</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.Auxio.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Auxio.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Auxio.BodySmall</item>
        <item name="textAppearanceBodyLargeEmphasized">@style/TextAppearance.Auxio.BodyLarge.Emphasized</item>
        <item name="textAppearanceBodyMediumEmphasized">@style/TextAppearance.Auxio.BodyMedium.Emphasized</item>
        <item name="textAppearanceBodySmallEmphasized">@style/TextAppearance.Auxio.BodySmall.Emphasized</item>

        <!-- Fix dumb default android behavior -->
        <item name="android:scrollbars">none</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorControlHighlight">@color/sel_compat_ripple</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>

        <!-- Work around hard-coded text highlight colors in the default Material3 theme -->
        <item name="android:textColorHighlight">@color/overlay_text_highlight</item>
        <item name="android:textColorHighlightInverse">@color/overlay_text_highlight_inverse</item>

        <item name="preferenceTheme">@style/PreferenceTheme.Fluxio</item>
        <item name="preferenceStyle">@style/Preference.Auxio</item>
        <item name="preferenceCategoryStyle">@style/Preference.Auxio.PreferenceCategory</item>
        <item name="dialogPreferenceStyle">@style/Preference.Auxio.DialogPreference</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.Auxio.SwitchPreferenceCompat
        </item>
        <item name="toolbarNavigationButtonStyle">@style/Widget.Fluxio.Toolbar.Navigation</item>
        <item name="actionOverflowButtonStyle">@style/Widget.Fluxio.Button.Overflow</item>
        <item name="materialButtonGroupStyle">@style/Widget.Fluxio.MaterialButtonGroup</item>
    </style>

    <!-- App theme now uses Theme.Fluxio (System) as the active theme -->
    <style name="Theme.Fluxio.App" parent="@style/Theme.Fluxio" />

    <!--
    Theming widgets is technically possible below Android 12, but I *really* don't care enough
    to bother with it.
    -->
    <style name="Theme.Fluxio.Widget" parent="@style/Theme.Fluxio" />
</resources>
