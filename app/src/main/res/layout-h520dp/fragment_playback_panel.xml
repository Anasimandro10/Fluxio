<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Toolbar ── -->
    <org.oxycblt.auxio.ui.ButtonGroupToolbar
        android:id="@+id/playback_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/toolbar_playback"
        app:navigationIcon="@drawable/ic_down_24"
        app:subtitleCentered="true"
        app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
        app:title="@string/lbl_playback"
        app:titleCentered="true"
        app:titleTextAppearance="?attr/textAppearanceLabelLargeEmphasized"
        tools:subtitle="@string/lbl_all_songs" />

    <!-- ── Artwork ── -->
    <org.oxycblt.auxio.playback.ui.ControlledCoverView
        android:id="@+id/playback_cover"
        style="@style/Widget.Fluxio.Image.Full"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/padding_player_horizontal"
        android:layout_marginTop="@dimen/gap_player_section"
        app:enablePlaybackIndicator="false"
        app:enableSelectionBadge="false"
        app:shapeAppearance="@style/ShapeAppearance.Fluxio.Artwork.Player"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@+id/playback_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/playback_info_container"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintWidth_percent="0.82"
        app:layout_constraintHeight_percent="0.57" />

    <!-- ── Fast-seek overlay (mismo bounds que el artwork) ── -->
    <org.oxycblt.auxio.playback.ui.stepper.PlayerFastSeekOverlay
        android:id="@+id/playback_fast_seek_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/padding_player_horizontal"
        android:layout_marginTop="@dimen/gap_player_section"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@+id/playback_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/playback_info_container" />

    <!-- ── Info: título + corazón + artista ── -->
    <LinearLayout
        android:id="@+id/playback_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_player_horizontal"
        android:layout_marginTop="@dimen/gap_artwork_to_info"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/playback_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/playback_seek_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/playback_song"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Fluxio.Display"
                android:textColor="?android:attr/textColorPrimary"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Song Name" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/playback_favorite"
                style="@style/Widget.Fluxio.Button.Playback.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription=""
                app:icon="@drawable/ic_playlist_add_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

        </LinearLayout>

        <TextView
            android:id="@+id/playback_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_title_subtitle"
            android:textAppearance="@style/TextAppearance.Fluxio.Headline"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Artist Name" />

    </LinearLayout>

    <!-- ── Seek bar ── -->
    <org.oxycblt.auxio.playback.ui.StyledSeekBar
        android:id="@+id/playback_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        app:layout_constraintTop_toBottomOf="@+id/playback_info_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/playback_controls_container" />

    <!-- ── Controles primarios ── -->
    <org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout
        android:id="@+id/playback_controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_player_horizontal"
        app:layout_constraintTop_toBottomOf="@+id/playback_seek_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/playback_secondary_controls"
        app:layout_constraintWidth_max="480dp">

        <com.google.android.material.button.MaterialButtonGroup
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:spacing="@dimen/spacing_small">

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/playback_skip_prev"
                style="@style/Widget.Fluxio.Button.Playback.Skip.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_skip_prev"
                app:icon="@drawable/ic_skip_prev_40"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large.Narrow" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/playback_play_pause"
                style="@style/Widget.Fluxio.Button.Playback.PlayPause.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_play_pause"
                app:icon="@drawable/sel_playing_state_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large"
                tools:icon="@drawable/ic_play_24" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/playback_skip_next"
                style="@style/Widget.Fluxio.Button.Playback.Skip.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_skip_next"
                app:icon="@drawable/ic_skip_next_40"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Large.Narrow" />

        </com.google.android.material.button.MaterialButtonGroup>

    </org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout>

    <!-- ── Controles secundarios ── -->
    <org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout
        android:id="@+id/playback_secondary_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_player_horizontal"
        app:layout_constraintTop_toBottomOf="@+id/playback_controls_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/playback_tab_bar"
        app:layout_constraintWidth_max="480dp">

        <com.google.android.material.button.MaterialButtonGroup
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:spacing="@dimen/spacing_small">

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/playback_shuffle"
                style="@style/Widget.Fluxio.Button.Playback.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_shuffle"
                app:icon="@drawable/sel_shuffle_state_24"
                app:tint="@color/sel_activatable_icon"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

            <org.oxycblt.auxio.ui.WidthFixMaterialButton
                android:id="@+id/playback_repeat"
                style="@style/Widget.Fluxio.Button.Playback.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_change_repeat"
                app:icon="@drawable/ic_repeat_off_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/playback_more"
                style="@style/Widget.Fluxio.Button.Playback.More"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription=""
                app:icon="@drawable/ic_more_24"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

        </com.google.android.material.button.MaterialButtonGroup>

    </org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout>

    <!-- ── Barra de tabs (Compose) ── -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/playback_compose_tabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_xs"
        app:layout_constraintTop_toBottomOf="@+id/playback_secondary_controls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
